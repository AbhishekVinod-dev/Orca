# ==============================================================================
# ORCA MARINE INTELLIGENCE PLATFORM — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM PROVIDER API KEYS (POOL ROTATION & RATE-LIMIT BALANCING)
# ------------------------------------------------------------------------------
# Groq API Keys (Comma-separated for multi-key pool load balancing)
GROQ_API_KEYS=gsk_your_groq_key_1,gsk_your_groq_key_2
GROQ_API_KEY=gsk_your_groq_key_1

# NVIDIA NIM API Keys (For deep reasoning & heavy LLMs)
NVIDIA_API_KEYS=nvapi-your_nvidia_key_1
NVIDIA_API_KEY=nvapi-your_nvidia_key_1

# OpenRouter / OpenAI Keys (Optional fallbacks)
OPENROUTER_API_KEYS=sk-or-v1-your_openrouter_key
OPENAI_API_KEYS=sk-proj-your_openai_key

# ------------------------------------------------------------------------------
# 2. PINECONE VECTOR DATABASE (STANDARD RAG STORE)
# ------------------------------------------------------------------------------
PINECONE_API_KEY=pcsk_your_pinecone_api_key
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=orca-maritime-rag
PINECONE_HOST=https://orca-maritime-rag-xxx.svc.us-east-1.pinecone.io

# ------------------------------------------------------------------------------
# 3. SARVAM AI (INDIAN LANGUAGE SPEECH-TO-TEXT & TRANSLATION)
# ------------------------------------------------------------------------------
SARVAM_API_KEY=your_sarvam_ai_api_key

# ------------------------------------------------------------------------------
# 4. POSTGRESQL & POSTGIS SPATIAL DATABASE (EEZ & GEOFENCING)
# ------------------------------------------------------------------------------
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=orca_db

# ------------------------------------------------------------------------------
# 5. FAST2SMS (FISHERMAN SMS ALERTS)
